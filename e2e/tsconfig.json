{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Specs run page.evaluate() callbacks in the browser, so DOM types are needed.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["**/*.ts"]
}
